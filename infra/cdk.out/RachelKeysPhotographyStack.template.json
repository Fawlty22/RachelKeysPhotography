  "PortfolioPipelineTriggerFunctionEFBF162A": {
   "Type": "AWS::Lambda::Function",
   "Properties": {
    "Code": {
     "ZipFile": "\nconst { CodeBuildClient, StartBuildCommand } = require('@aws-sdk/client-codebuild');\nconst client = new CodeBuildClient({});\n\nexports.handler = async (event) => {\n  const secret = process.env.REBUILD_SECRET;\n  const provided = (event.headers || {})['x-rebuild-secret'];\n\n  if (provided !== secret) {\n    console.log('Rejected: invalid or missing X-Rebuild-Secret');\n    return { statusCode: 401, body: JSON.stringify({ error: 'Unauthorized' }) };\n  }\n\n  try {\n    const result = await client.send(new StartBuildCommand({ projectName: process.env.PROJECT_NAME }));\n    const buildId = result.build.id;\n    console.log('CodeBuild build started:', buildId);\n    return {\n      statusCode: 200,\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ buildId }),\n    };\n  } catch (err) {\n    console.error('Failed to start build:', err);\n    return {\n      statusCode: 500,\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ error: 'Failed to start build' }),\n    };\n  }\n};\n      "
    },
    "Description": "Receives a POST from the CMS and starts a CodeBuild portfolio rebuild",
    "Environment": {
     "Variables": {
      "PROJECT_NAME": {
       "Ref": "PortfolioPipelineBuildProject50E15983"
      },
      "REBUILD_SECRET": "HarperTheGoose"
     }
    },
    "FunctionName": "rachel-keys-portfolio-trigger",
    "Handler": "index.handler",
    "Role": {
     "Fn::GetAtt": [
      "PortfolioPipelineTriggerRoleA4F67F74",
      "Arn"
     ]
    },
    "Runtime": "nodejs20.x",
    "Timeout": 10
   },
   "DependsOn": [
    "PortfolioPipelineTriggerRoleDefaultPolicyD4E7FB30",
    "PortfolioPipelineTriggerRoleA4F67F74"
   ],
   "Metadata": {
    "aws:cdk:path": "RachelKeysPhotographyStack/PortfolioPipeline/TriggerFunction/Resource"
   }
  },
